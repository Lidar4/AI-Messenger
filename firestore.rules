rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users profile collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public username mapping collection for contact discovery
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.participants.hasAny([request.auth.uid]) || request.resource.data.participants.hasAny([request.auth.uid]));

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
      }
    }
  }
}
